# HTTP server. Use 0.0.0.0 only when the deployment needs an external bind.
HOST=127.0.0.1
PORT=3000

# Required for OCR requests; /health does not need it.
SERVICE_TOKEN=

# Python executable (not a command with arguments). Required for valid OCR inputs.
# Windows: .venv/Scripts/python.exe; Linux/macOS: .venv/bin/python.
PYTHON_COMMAND=python

# GPT integration starts in task 8. Leave credentials/model empty for /health.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Proposed contract limits, expressed in bytes/pages/pixels/milliseconds.
MAX_FILE_BYTES=10485760
MAX_JSON_BODY_BYTES=14680064
MAX_PDF_PAGES=3
MAX_IMAGE_PIXELS=20000000
PROCESSING_TIMEOUT_MS=40000

# Child-process output limits. Diagnostics are discarded, not logged.
MAX_PREPROCESS_STDOUT_BYTES=67108864
MAX_PREPROCESS_STDERR_BYTES=65536
