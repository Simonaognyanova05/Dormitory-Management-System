# HTTP server. Use 0.0.0.0 only when the deployment needs an external bind.
HOST=127.0.0.1
PORT=3000

# Used for internal OCR requests starting in task 5; /health does not need it.
SERVICE_TOKEN=

# Python executable (not a command with arguments).
# After setting up Python on Windows, use .venv/Scripts/python.exe.
PYTHON_COMMAND=python

# GPT integration starts in task 8. Leave credentials/model empty for /health.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Proposed contract limits, expressed in bytes/pages/milliseconds.
MAX_FILE_BYTES=10485760
MAX_JSON_BODY_BYTES=14680064
MAX_PDF_PAGES=3
PROCESSING_TIMEOUT_MS=40000
